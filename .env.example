# ==========================================================================
#  ระบบแจ้งชำระเงินตามวัตถุประสงค์การจัดเก็บ — โรงเรียนทุนวิทยาคม
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามการใช้งานจริง:  cp .env.example .env
# ==========================================================================

# ---------- เซิร์ฟเวอร์ ----------
PORT=3000
HOST=0.0.0.0

# โหมดการทำงาน: development (ทดสอบ) หรือ production (ใช้งานจริง)
NODE_ENV=production

# ---------- ความปลอดภัย (สำคัญมาก) ----------
# กุญแจเข้ารหัสเซสชัน — ต้องเปลี่ยนก่อนใช้งานจริง!
# สร้างค่าสุ่มด้วยคำสั่ง:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=เปลี่ยนค่านี้เป็นข้อความสุ่มยาวอย่างน้อย-32-ตัวอักษร

# ตั้งเป็น true เมื่อเปิดผ่าน HTTPS เท่านั้น (แนะนำอย่างยิ่งสำหรับการใช้งานจริง)
COOKIE_SECURE=false

# จำนวนชั้นของ proxy/reverse proxy ที่อยู่หน้าเซิร์ฟเวอร์ (0 = ไม่มี, 1 = Nginx/Cloudflare)
TRUST_PROXY=1

# โดเมนเพิ่มเติมที่อนุญาตให้ส่งคำขอเข้ามา (คั่นด้วยเครื่องหมายจุลภาค) — ปกติไม่ต้องตั้ง
# ALLOWED_ORIGINS=https://pay.school.ac.th

# ที่อยู่เว็บสำหรับสร้างลิงก์ในอีเมลรีเซ็ตรหัสผ่าน
APP_URL=http://localhost:3000

# ---------- ที่เก็บข้อมูล ----------
# โฟลเดอร์เก็บฐานข้อมูลและไฟล์สลิป (ค่าเริ่มต้นคือ ./data)
# DATA_DIR=/var/lib/cwk-payment

# ---------- อีเมล (สำหรับลิงก์รีเซ็ตรหัสผ่านผู้ดูแล) ----------
# ถ้าไม่ตั้งค่า ระบบยังทำงานได้ปกติ โดยจะบันทึกอีเมลเป็นไฟล์ไว้ที่ data/outbox
# และแสดงลิงก์ใน console ของเซิร์ฟเวอร์
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=ระบบแจ้งชำระเงิน <no-reply@school.ac.th>

# ---------- ติดตั้งครั้งแรกแบบอัตโนมัติ (ไม่บังคับ) ----------
# ถ้าตั้งค่าทั้งสามค่านี้ คำสั่ง npm run setup จะสร้างบัญชีผู้ดูแลให้โดยไม่ต้องถาม
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=
# ADMIN_NAME=ผู้ดูแลระบบ
# SCHOOL_NAME=โรงเรียนทุนวิทยาคม
